# ─────────────────────────────────────────────────────────────
# Espião de Ofertas Escaladas — variáveis de ambiente
# ⚠️ Este arquivo é só um MODELO; nunca coloque chaves reais aqui.
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# ─────────────────────────────────────────────────────────────

# --- Provedores de dados / IA ---
APIFY_TOKEN=your_apify_token
EXA_API_KEY=your_exa_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# Usado como fallback de transcrição (Whisper). Opcional se TRANSCRIPTION_PROVIDER=openrouter e ele funcionar.
OPENAI_API_KEY=your_openai_api_key

# --- Supabase (nuvem) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Só no worker e nas rotas de servidor. NUNCA exponha no browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Apify actor ---
# Actor da Meta Ad Library. Padrão confirmado via Apify (id JJghSZmShuco4j9gJ).
APIFY_META_ADS_ACTOR=apify/facebook-ads-scraper

# --- Modelos ---
# Modelo de análise de criativos (OpenRouter).
LLM_MODEL_ANALYSIS=anthropic/claude-sonnet-4.5
# Modelo usado para descoberta/extração de candidatos (OpenRouter).
LLM_MODEL_DISCOVERY=anthropic/claude-sonnet-4.5

# --- Transcrição ---
# openrouter | openai
TRANSCRIPTION_PROVIDER=openai
# Para openrouter: um modelo multimodal com entrada de áudio (ex.: google/gemini-2.5-flash).
# Para openai: whisper-1
TRANSCRIPTION_MODEL=whisper-1

# --- App ---
# URL pública do app (usada pelo Caddy/worker para montar links).
APP_BASE_URL=http://localhost:3000
# Domínio para o Caddy emitir HTTPS automático (produção).
APP_DOMAIN=espiao.seudominio.com
# E-mail do único usuário permitido (bloqueia qualquer outro login).
ALLOWED_USER_EMAIL=voce@exemplo.com
